# Eagle Auctioner - Enterprise Environment Configuration Template
# Copy this file to .env.local (development) or .env.production (production)

# Frontend Environment Variables
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=wss://app.eagleauctioner.com/ws
VITE_APP_ENV=production

# Backend Server & Security Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET_KEY=replace_with_a_secure_256_bit_base64_encoded_secret_key_in_production
APPLICATION_CORS_ALLOWED_ORIGINS=https://app.eagleauctioner.com,https://admin.eagleauctioner.com

# PostgreSQL Database Configuration
DATABASE_URL=jdbc:postgresql://db:5432/eagleauctioner
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace_with_secure_db_password

# Redis Cache & Broker Configuration
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace_with_secure_redis_password

# File Upload Storage Directory
UPLOAD_DIR=/app/uploads
