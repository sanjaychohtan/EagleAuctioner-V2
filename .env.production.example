# ==============================================================================
# EAGLE AUCTIONER - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production)
# ==============================================================================
# Instructions: Copy this file to .env.production on the production host server.
# Replace all placeholder values with actual cryptographically secure secrets.
# NEVER commit .env.production to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Domain Settings
# ------------------------------------------------------------------------------
TZ=UTC
VITE_APP_ENV=production
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=wss://app.eagleauctioner.com/ws

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=eagle_auctioner
DATABASE_USERNAME=eagle_prod_user
DATABASE_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_MIN_32_CHARS
DATABASE_URL=jdbc:postgresql://db:5432/eagle_auctioner

# ------------------------------------------------------------------------------
# 3. Cache & Session Storage Configuration (Redis 7)
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_MIN_32_CHARS

# ------------------------------------------------------------------------------
# 4. Backend Server & Security Configuration (Spring Boot 3.2)
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET_KEY=YOUR_256_BIT_BASE64_ENCODED_JWT_SECRET_KEY_HERE
APPLICATION_CORS_ALLOWED_ORIGINS=https://app.eagleauctioner.com,https://admin.eagleauctioner.com
HIKARI_MAX_POOL_SIZE=20

# ------------------------------------------------------------------------------
# 5. File Upload Storage Directory
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
